# Kalshi API credentials.
#
# Kalshi generates the key pair for you: on your kalshi.com account page, open
# the API keys section, create a key, and you receive an API key id plus a
# one-time download of the private-key .pem. There is no openssl generate step.
#
# Provide the private key EITHER as a file path OR inline (path takes a file,
# inline takes precedence if both are set).

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=

# Optional endpoint overrides (defaults target Kalshi production).
# KALSHI_API_URL=
# KALSHI_WS_URL=

# Optional: market status string the settlement poller filters on (default: settled).
# KALSHI_SETTLE_STATUS=
